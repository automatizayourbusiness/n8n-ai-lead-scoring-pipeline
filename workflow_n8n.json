        },
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Lead successfully processed and scored.\",\n  \"lead_score\": $json.lead_score,\n  \"qualification\": $json.qualification\n}"
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
